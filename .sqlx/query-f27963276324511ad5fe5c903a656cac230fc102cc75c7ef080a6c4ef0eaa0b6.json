  "query": "SELECT a.id, u.username, a.name, a.sport_type, a.recorded_at, a.distance_m, a.track IS NOT NULL AS \"tracked!\"\n           FROM game_activity a JOIN accounts_user u ON u.id = a.user_id\n           WHERE $1::bigint IS NULL OR a.user_id = $1 ORDER BY a.recorded_at DESC, a.id DESC",
