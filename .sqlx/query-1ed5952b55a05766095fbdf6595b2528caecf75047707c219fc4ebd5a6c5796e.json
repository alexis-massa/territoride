{
  "db_name": "PostgreSQL",
  "query": "SELECT COALESCE(a.sport_type, '') AS \"sport_type!\", a.distance_m, c.captured_at, count(*) AS \"n!\"\n           FROM game_territorycell c LEFT JOIN game_activity a ON a.id = c.captured_by_id\n           WHERE c.owner_id = $1 AND COALESCE(a.sport_type, '') <> ALL($2)\n           GROUP BY a.sport_type, a.distance_m, c.captured_at",
