  "query": "SELECT p.name, p.poi_type, p.altitude_m, p.claimed_at AS \"claimed_at!\", a.sport_type AS \"sport_type?\"\n           FROM game_poi p LEFT JOIN game_activity a ON a.id = p.claimed_by_id\n           WHERE p.owner_id = $1 AND p.claimed_at IS NOT NULL ORDER BY p.claimed_at DESC",
