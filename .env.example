# Settings for local development. `just db-up` copies this to .env the first time; never commit .env.
# On the Pi, ~/territoride/.env is written by pi-infra's add-app.sh (DATABASE_URL) plus the rest.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/territoride
APP_DOMAIN=localhost
BIND_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
SESSION_DAYS=30
RUST_LOG=info

# Strava: https://www.strava.com/settings/api ("Authorization Callback Domain": localhost for local dev)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string, used to verify the webhook subscription handshake
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Fernet key for the stored Strava tokens (the same key keeps the existing tokens readable):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Where the in-process daily release of expired captures runs (UTC hour); 0 disables it (use the CLI)
# DECAY_HOUR_UTC=4
